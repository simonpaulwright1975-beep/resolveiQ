# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# ---------- Sage CRM ----------
# Sage CRM is LAN-only — this app must run on a machine that can reach it
# (WG-SQL-01 or another box on the Geerings LAN). It is not reachable from
# the cloud, so a cloud-hosted copy will always fall back to sample data.
#
# Either give the full SData base URL...
# SAGE_BASE_URL=http://WG-SQL-01/sdata/crmj/sagecrm/-/
# ...or the parts and let the app build it:
#   {SAGE_SERVER}/sdata/{SAGE_INSTALL}j/{SAGE_CONTRACT}/-/
SAGE_SERVER=http://WG-SQL-01
SAGE_INSTALL=crm
SAGE_CONTRACT=sagecrm

SAGE_USER=apiuser
SAGE_PASSWORD=

# Cases fetched per refresh, and how long a queue response is reused.
SAGE_PAGE_SIZE=50
SAGE_CACHE_SECONDS=30

# Only if your CRM uses an internal certificate authority.
SAGE_ALLOW_INSECURE_TLS=false

# ---------- Claude ----------
# Without this, the console still runs; the "Draft a reply" button returns a
# clear message instead of a draft.
ANTHROPIC_API_KEY=
RESOLVEIQ_MODEL=claude-opus-5
RESOLVEIQ_EFFORT=medium
RESOLVEIQ_MAX_TOKENS=4000

# ---------- SLA policy ----------
# Minutes allowed per CRM priority value before a case counts as breached.
SLA_POLICY={"High":20,"Medium":60,"Low":240,"Default":60}

PORT=3000
