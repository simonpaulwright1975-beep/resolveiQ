# Copy to .env and fill in. .env is gitignored — never commit credentials.

# ---------- ClientiQ (the customer database) ----------
# ResolveIQ reads companies, contacts and activity from here, writes its cases
# here, and queues Sage CRM notes from here. It never touches Sage CRM or the
# LAN directly, so it can run anywhere with outbound HTTPS.
SUPABASE_URL=https://hlfhyzqkzqgyuohhmzzu.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_r9QqxX4eUYuMGngw325DKg_Z_YLhfTF

# A real WG account. Every ClientiQ view is granted to `authenticated`, so the
# key alone grants nothing — a signed-in session is required.
RESOLVEIQ_SUPABASE_EMAIL=
RESOLVEIQ_SUPABASE_PASSWORD=

# NEVER set a service-role key here. It bypasses every permission check and
# belongs only in the on-prem worker's env. The app warns loudly if it sees one.

RESOLVEIQ_CACHE_SECONDS=30

# ---------- Who the team is ----------
# Keep these separate from the sign-in above. That account is a machine
# credential: generic, internal, and never seen by a customer.
#
# The address customers see and reply to. Used in drafted replies and, if
# sending is ever built, as the From. Never an individual's mailbox.
RESOLVEIQ_TEAM_EMAIL=customerservice@waltergeering.co.uk
RESOLVEIQ_TEAM_NAME=Customer Service

# The advisor working the queue, recorded as the owner of cases she raises.
# There is no login, so it is configured rather than derived. Leave it blank
# and cases are owned by the team address above — which is honest. What it
# must never be is the sign-in account, or every case looks like the robot
# dealt with it.
RESOLVEIQ_ADVISOR_EMAIL=

# ---------- Claude ----------
# Without this the console still runs; "Draft a reply" returns a clear message.
#
# The key Call iQ and the other apps already use will work here — an Anthropic
# key is an org credential, not tied to an app. Three things are pooled if you
# share one, though:
#
#   Rate limits   ResolveIQ's drafting competes with Call iQ's recap processing
#                 for the same bucket. Watch this if Call iQ's backlog of
#                 unprocessed calls ever drains.
#   Spend         One key is one line on the bill — you cannot then answer
#                 "what is ResolveIQ costing us?"
#   Rotation      Rotating a shared key stops every app until each is updated.
#
# All three are solved by giving ResolveIQ its own Anthropic *workspace*: its
# own key, own rate limits, own spend line. That is a Console setting, not a
# code change — only the value below changes.
#
# Rough cost: ~3p per drafted reply on claude-opus-5 at medium effort, so
# roughly £20-25/month at 30 drafts a day. Estimated, not measured.
# RESOLVEIQ_EFFORT=low is the first lever if that ever matters.
ANTHROPIC_API_KEY=
RESOLVEIQ_MODEL=claude-opus-5
RESOLVEIQ_EFFORT=medium
RESOLVEIQ_MAX_TOKENS=4000

# ---------- CSAT ----------
# Customer satisfaction is collected with a signed link the advisor pastes into
# her reply — ResolveIQ sends no email of its own. Without a secret the feature
# is off and the console says so.
#
# There is deliberately no default. A fallback would live in the repository, and
# anyone who read it could forge a satisfaction score for any case. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RESOLVEIQ_FEEDBACK_SECRET=

# Where a customer's browser reaches this app. The link goes in an email, so it
# has to be absolute and work from outside — localhost is no use to a customer.
# Left blank, the link is built from the request's own host, which is fine for
# testing and wrong in production.
RESOLVEIQ_PUBLIC_URL=

# How long a link stays usable. A rating request in a month-old email should not
# still be answerable.
RESOLVEIQ_FEEDBACK_MAX_AGE_DAYS=30

# ---------- SLA policy ----------
# Minutes allowed per priority before a case counts as breached.
SLA_POLICY={"High":20,"Medium":60,"Low":240,"Default":60}

PORT=3000
